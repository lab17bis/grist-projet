{
 "tables": {
  "Structures": [
   {
    "id": "Nom",
    "type": "Text"
   },
   {
    "id": "Sigle",
    "type": "Text"
   },
   {
    "id": "Type",
    "type": "Choice",
    "widgetOptions": {
     "choices": [
      "Site",
      "Direction",
      "Division",
      "Bureau",
      "Service",
      "Mission",
      "Corps d'inspection",
      "Partenaire"
     ]
    }
   },
   {
    "id": "Parent",
    "type": "Ref:Structures",
    "label": "Rattachée à",
    "visibleCol": "Libelle"
   },
   {
    "id": "Libelle",
    "type": "Text",
    "isFormula": true,
    "formula": "($Sigle + \" – \" if $Sigle else \"\") + $Nom",
    "label": "Libellé"
   },
   {
    "id": "Chemin",
    "type": "Text",
    "isFormula": true,
    "formula": "n = rec\nparts = []\nwhile n and len(parts) < 8:\n  parts.insert(0, n.Sigle or n.Nom)\n  n = n.Parent\nreturn \" › \".join(parts)"
   },
   {
    "id": "Active",
    "type": "Bool",
    "formula": "True"
   }
  ],
  "Personnes": [
   {
    "id": "Nom",
    "type": "Text",
    "label": "Nom et prénom"
   },
   {
    "id": "Email_saisi",
    "type": "Text",
    "label": "Email saisi par un administrateur"
   },
   {
    "id": "Structure",
    "type": "Ref:Structures",
    "label": "Structure de rattachement",
    "visibleCol": "Libelle"
   },
   {
    "id": "Cree_par",
    "type": "Text",
    "formula": "(user.Email or \"\").strip().lower()"
   },
   {
    "id": "Compte_lie",
    "type": "Bool",
    "isFormula": true,
    "formula": "bool($Email)",
    "label": "Compte lié"
   },
   {
    "id": "Email",
    "type": "Text",
    "isFormula": true,
    "formula": "if $Email_saisi:\n  return $Email_saisi.strip().lower()\nemails = set(c.Email.strip().lower() for c in Comptes.lookupRecords(Profil=$id) if c.Email)\nreturn emails.pop() if len(emails) == 1 else \"\""
   },
   {
    "id": "Cree_le",
    "type": "DateTime:Europe/Paris",
    "formula": "NOW()",
    "label": "Créé le"
   },
   {
    "id": "Connecte",
    "type": "Bool",
    "isFormula": true,
    "formula": "bool($Email) and bool(Comptes.lookupOne(Email=$Email))",
    "label": "Connecté"
   },
   {
    "id": "Doublon_email",
    "type": "Bool",
    "isFormula": true,
    "formula": "bool($Email) and len(Personnes.lookupRecords(Email=$Email)) > 1",
    "label": "Email en double"
   },
   {
    "id": "Cle_nom",
    "type": "Text",
    "isFormula": true,
    "formula": "import unicodedata, re\nt = unicodedata.normalize(\"NFD\", $Nom or \"\").encode(\"ascii\", \"ignore\").decode().lower()\nreturn \" \".join(sorted(re.findall(r\"[a-z]+\", t)))",
    "label": "Clé nom"
   },
   {
    "id": "A_verifier",
    "type": "Text",
    "isFormula": true,
    "formula": "r = []\ndom = (Parametres.lookupOne(Cle=\"Domaine_courriel\").Valeur or \"\").strip().lstrip(\"@\").lower()\nif not $Email:\n  r.append(\"sans email\")\nelif dom and not $Email.lower().endswith(\"@\" + dom):\n  r.append(\"email hors domaine\")\nif $Doublon_email:\n  r.append(\"email en double\")\nif $Cle_nom and len(Personnes.lookupRecords(Cle_nom=$Cle_nom)) > 1:\n  r.append(\"nom en double\")\nif $Email and not $Connecte and $Cree_le and (NOW() - $Cree_le).days >= 30:\n  r.append(\"jamais connecté depuis 30 jours\")\nreturn \", \".join(r)",
    "label": "À vérifier"
   }
  ],
