   {
    "id": "Cree_par",
    "type": "Text",
    "formula": "(user.Email or \"\").strip().lower()",
    "label": "Créé par"
   },
   {
    "id": "Cree_le",
    "type": "DateTime:Europe/Paris",
    "formula": "NOW()",
    "label": "Créé le",
    "widgetOptions": {
     "dateFormat": "DD/MM/YYYY",
     "timeFormat": "HH:mm"
    }
   },
   {
    "id": "Maj_le",
    "type": "DateTime:Europe/Paris",
    "formula": "NOW()",
    "label": "Fiche modifiée le",
    "widgetOptions": {
     "dateFormat": "DD/MM/YYYY",
     "timeFormat": "HH:mm"
    }
   },
   {
    "id": "Acces",
    "type": "ChoiceList",
    "isFormula": true,
    "formula": "[p.Email for p in $Porteurs if p.Email] + ([$Cree_par] if $Cree_par else [])",
    "label": "Droits d'édition (calculé)"
   },
   {
    "id": "Lecteurs",
    "type": "ChoiceList",
    "isFormula": true,
    "formula": "list($Acces) + [p.Email for p in $Equipe if p.Email] + ([$Commanditaire.Email] if $Commanditaire and $Commanditaire.Email else [])",
    "label": "Droits de lecture si restreint (calculé)"
   },
   {
    "id": "Avancement",
    "type": "Numeric",
    "isFormula": true,
    "formula": "acts = [a for a in Actions.lookupRecords(Projet=$id) if a.Etat != \"Abandonné\"]\nif not acts:\n  return None\nreturn round(100.0 * len([a for a in acts if a.Etat == \"Fait\"]) / len(acts))",
    "label": "Avancement (% d'actions faites)"
   },
   {
    "id": "Derniere_activite",
    "type": "DateTime:Europe/Paris",
    "isFormula": true,
    "formula": "dates = [$Maj_le] + [j.Cree_le for j in Journal.lookupRecords(Projet=$id)] + [a.Maj_le for a in Actions.lookupRecords(Projet=$id)]\ndates = [d for d in dates if d]\nreturn max(dates) if dates else None",
    "label": "Dernière activité",
    "widgetOptions": {
     "dateFormat": "DD/MM/YYYY",
     "timeFormat": "HH:mm"
    }
   },
   {
    "id": "Jours_sans_activite",
    "type": "Int",
    "isFormula": true,
    "formula": "return (NOW() - $Derniere_activite).days if $Derniere_activite else None",
    "label": "Jours sans activité"
   },
   {
    "id": "Archive",
    "type": "Bool",
    "isFormula": true,
    "formula": "$Phase == \"Clos\" or $Etat in (\"Terminé\", \"Abandonné\")",
    "label": "Archivé"
   },
   {
    "id": "Contributeurs",
    "type": "ChoiceList",
    "isFormula": true,
    "formula": "list($Acces) + [p.Email for p in $Equipe if p.Email]",
    "label": "Droits de contribution (calculé)"
   },
   {
    "id": "Config_suivi",
    "type": "Text",
    "isFormula": true
